@startuml C4_Component
!include <C4/C4_Component>
LAYOUT_LEFT_RIGHT()
skinparam shadowing false

Container_Boundary(app, "Application Spring Boot") {
  Component(mvc, "Contrôleurs MVC", "com.projet.auto_battler.controller", "Pages d'accueil, compte, donjons, monstres, équipements et compétences")
  Component(rest, "Contrôleurs REST", "com.projet.auto_battler.rest", "ping, dungeons, monsters, equipment")
  Component(webErrors, "WebExceptionHandler", "Spring MVC", "404 HTML pour ResourceNotFoundException, limité au package controller")
  Component(services, "Services", "com.projet.auto_battler.service", "Règles métier, transactions et mapping DTO")
  Component(repos, "Repositories", "Spring Data JPA", "Player, PlayerProfile, Dungeon, Monster, Equipment, Skill")
  Component(views, "Vues Thymeleaf", "src/main/resources/templates", "Formulaires et pages serveur")
}

ContainerDb(db, "H2", "Fichier local", "Schéma produit par Hibernate")

Rel(mvc, services, "Appelle")
Rel(rest, services, "Appelle")
Rel(mvc, views, "Sélectionne une vue")
Rel(webErrors, views, "Affiche error/404")
Rel(services, repos, "Persiste via")
Rel(repos, db, "JDBC")

SHOW_LEGEND()
@enduml
