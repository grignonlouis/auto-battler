meta {
  name: Get equipment by id
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/equipment/{{equipmentId}}
  body: none
  auth: none
}

tests {
  test("returns 200 with the equipment", function () {
    expect(res.status).to.equal(200);
    expect(res.body.id).to.equal(bru.getVar("equipmentId"));
  });
}