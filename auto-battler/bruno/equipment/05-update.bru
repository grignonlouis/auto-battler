meta {
  name: Update equipment
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/v1/equipment/{{equipmentId}}
  body: json
  auth: none
}

body:json {
  {
    "name": "Iron Sword",
    "slot": "WEAPON",
    "rarity": "RARE",
    "bonusAttack": 8,
    "bonusHealth": 0,
    "bonusDefense": 0,
    "bonusSpeed": 0
  }
}

tests {
  test("returns 200 with updated values", function () {
    expect(res.status).to.equal(200);
    expect(res.body.bonusAttack).to.equal(8);
    expect(res.body.rarity).to.equal("RARE");
  });
}