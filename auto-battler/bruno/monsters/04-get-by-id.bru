meta {
  name: Get monster by id
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/monsters/{{monsterId}}
  body: none
  auth: none
}

tests {
  test("returns 200 with the monster", function () {
    expect(res.status).to.equal(200);
    expect(res.body.id).to.equal(bru.getVar("monsterId"));
  });
}